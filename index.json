                            "updated_at": "2026-07-06 21:41:31"
                        },
                        {
                            "id": "42",
                            "tc_id": "111",
                            "thread_id": "",
                            "user_id": "1",
                            "message": "Test Case: 1\n\nTest Case Title: Successful Login with Valid Credentials\nModule: Login Page\nPriority: High\n\nPreconditions:\n- User has a valid Facebook account.\n- User is on the Facebook login page.\n\nTest Steps:\n1. Enter a valid email address in the email or phone field.\n2. Enter the correct password in the password field.\n3. Click the Log In button.\n4. Observe the system response.\n\nExpected Result:\n- User is redirected to the Facebook homepage.\n- User profile picture or name is displayed according to the logged-in account.\n- No error messages are shown.",
                            "message_type": "replier",
                            "created_at": "2026-07-06 21:41:37",
                            "updated_at": "2026-07-06 21:41:37"
                        }
                    ]
